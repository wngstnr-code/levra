NODE_ENV=development
PORT=8787
# Matches docker-compose.yml at the repo root. The indexer fills it
DATABASE_URL=postgres://levra:levra@localhost:5442/levra
# Local fork from `make fork` in contracts/. Use a paid provider in staging and production
MONAD_RPC_URL=http://127.0.0.1:8545
# Written by `make deploy-fork` (fork.json) or the mainnet deployment (monad.json). Relative to apps/api
DEPLOYMENT_FILE=../../contracts/deployments/fork.json
LOG_LEVEL=info
KYBER_BASE_URL=https://aggregator-api.kyberswap.com/monad/api/v1
KYBER_CLIENT_ID=levra
# Wallet sign-in and alert settings (BE-33). Leave AUTH_SECRET empty to keep them off. At least 32 random characters, never commit a real one
AUTH_SECRET=
# Hosts of the web app that a sign-in message may name, comma-separated; * stands for one dash-separated part
AUTH_DOMAIN=localhost:3000
# Web origins allowed to call the API from a browser, same pattern rules
CORS_ORIGINS=http://localhost:3000
# Username of the alert bot, without @. Leave empty to keep the Telegram link off
TELEGRAM_BOT_USERNAME=
# Aurora Intents partner token for cross-chain transfers (BE-40). Optional; without it the service adds a 0.2% fee. Never commit it
INTENTS_JWT=
# Region and terms (BE-52). TERMS_VERSION is the version users must accept; the gate routes are off without it
TERMS_VERSION=
# Header with the visitor's ISO country from the CDN (for example cf-ipcountry), and the codes to refuse, decided with counsel (X-10)
GEO_COUNTRY_HEADER=
BLOCKED_COUNTRIES=
