NODE_ENV=development
PORT=8787
# Local fork from `make fork` in contracts/. Use a paid provider in staging and production
MONAD_RPC_URL=http://127.0.0.1:8545
# Written by `make deploy-fork` (fork.json) or the mainnet deployment (monad.json). Relative to apps/api
DEPLOYMENT_FILE=../../contracts/deployments/fork.json
LOG_LEVEL=info
