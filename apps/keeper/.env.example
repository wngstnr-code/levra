NODE_ENV=development
# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://levra:levra@localhost:5442/levra
# Public endpoint: 300 requests per 10 seconds. Use a paid provider in staging and production
MONAD_RPC_URL=https://rpc2.monad.xyz
# Blocks the oracle recorder reads back on its first start (about two weeks)
ORACLE_BACKFILL_BLOCKS=4000000
LOG_LEVEL=info
# Relative to apps/keeper. Needed by the oracle age poster
DEPLOYMENT_FILE=../../contracts/deployments/fork.json
# Oracle age poster key (BE-17). Leave empty to keep the job off. Never commit a real key
ORACLE_AGE_POSTER_KEY=
# Calendar poster key (BE-30). Leave empty to keep the job off. Never commit a real key
CALENDAR_POSTER_KEY=
# Router keeper key for auto-deleverage (BE-31). Leave empty to keep the job off. Never commit a real key
PROTECTOR_KEY=
# User alerts (BE-33). Email through Resend needs both values; Telegram needs the bot token. Leave empty to keep a channel off. Never commit real keys
RESEND_API_KEY=
ALERT_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
# Liquidator keeper key (BE-32). Leave empty to keep the bot off. Never commit a real key
LIQUIDATOR_KEY=
