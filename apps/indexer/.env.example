NODE_ENV=development
# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://levra:levra@localhost:5442/levra
# Used when ENVIO_API_TOKEN is empty. Public endpoint: 300 requests per 10 seconds
MONAD_RPC_URL=https://rpc2.monad.xyz
# Relative to apps/indexer
DEPLOYMENT_FILE=../../contracts/deployments/fork.json
# Envio HyperSync token from https://app.envio.dev/api-tokens. When set, HyperSync is the log source
ENVIO_API_TOKEN=
HYPERSYNC_URL=https://monad.hypersync.xyz
POLL_MS=2000
LOG_LEVEL=info
