NODE_ENV=development
# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://levra:levra@localhost:5442/levra
# The chain this indexer reads: 143 Monad, 8453 Base, 196 X Layer (BE-95)
CHAIN_ID=143
# RPC endpoint of CHAIN_ID; MONAD_RPC_URL is also read for chain 143.
# Used when ENVIO_API_TOKEN is empty. Public endpoint: 300 requests per 10 seconds
RPC_URL=https://rpc2.monad.xyz
# Relative to apps/indexer
DEPLOYMENT_FILE=../../contracts/deployments/fork.json
# Envio HyperSync token from https://app.envio.dev/api-tokens. When set, HyperSync is the log source
ENVIO_API_TOKEN=
# Defaults to https://monad.hypersync.xyz on Monad. Base and X Layer use the RPC unless this is set (not verified yet)
HYPERSYNC_URL=
POLL_MS=2000
LOG_LEVEL=info
