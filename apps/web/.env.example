# RPC endpoint for the browser. The public Monad endpoint is used when empty.
NEXT_PUBLIC_MONAD_RPC_URL=
# Backend address. For local development against the live API, which only allows the app's own origin,
# set NEXT_PUBLIC_API_URL=http://localhost:3000/api-proxy and API_PROXY_TARGET=https://api.levra.finance.
NEXT_PUBLIC_API_URL=
# Dev server only: where /api-proxy forwards to. Ignored in production builds.
API_PROXY_TARGET=
# Privy app ID from the Privy dashboard. Sign-in is off when empty.
NEXT_PUBLIC_PRIVY_APP_ID=
