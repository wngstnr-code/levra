# API_HOST comes from env/caddy.env: api.levra.finance (D-96).
{$API_HOST} {
	# Who may connect: anyone while the Cloudflare record is DNS only, Cloudflare only once it is proxied (BE-52).
	# ORIGIN in caddy.env picks origin-open.caddy or origin-cloudflare.caddy; deploy.sh checks it against api.env.
	import origin-{$ORIGIN:open}.caddy
	encode zstd gzip
	# Caddy replaces any X-Forwarded-For sent by the client, so the API can trust it (TRUST_PROXY_HEADER).
	reverse_proxy api:8787 {
		# The price stream is server-sent events and must not be buffered.
		flush_interval -1
	}
}
