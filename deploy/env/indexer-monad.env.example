# Copy to /opt/levra/env/indexer-monad.env. Secrets go in /opt/levra/secrets/indexer-monad/ (see secrets.md).
LOG_LEVEL=info
# One indexer per chain (BE-95): 143 Monad, 8453 Base, 196 X Layer. The deployment file must be for the same chain
CHAIN_ID=143
RPC_URL=https://rpc2.monad.xyz
DEPLOYMENT_FILE=/app/contracts/deployments/monad.json
HYPERSYNC_URL=https://monad.hypersync.xyz
POLL_MS=2000
