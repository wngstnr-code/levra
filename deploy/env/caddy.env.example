# Copy to /opt/levra/env/caddy.env.
# The API address (D-96). Its Cloudflare record must point at the server, DNS only, when Caddy first asks for the
# certificate (docs/hosting.md)
API_HOST=api.levra.finance
# Who may connect (BE-52): open while the record is DNS only, cloudflare once it is proxied. Change it together with
# TRUST_PROXY_HEADER and the GEO headers in api.env; deploy.sh refuses a mismatch (docs/hosting.md, "Cloudflare in front")
ORIGIN=open
