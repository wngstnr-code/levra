# Copy to /opt/levra/env/indexer-base.env. Secrets go in /opt/levra/secrets/indexer-base/ (see secrets.md).
LOG_LEVEL=info
# Base (BE-73). The deployment file must be for the same chain
CHAIN_ID=8453
# mainnet.base.org answers eth_getLogs with 429; publicnode serves 10,000 blocks per query with block timestamps (24 November 2026)
RPC_URL=https://base-rpc.publicnode.com
DEPLOYMENT_FILE=/app/contracts/deployments/base.json
LOG_BLOCK_RANGE=10000
POLL_MS=2000
