# Copy to /opt/levra/env/keeper-monad.env. Secrets go in /opt/levra/secrets/keeper-monad/ (see secrets.md).
LOG_LEVEL=info
# One keeper per chain (BE-95). Exactly one keeper sets KEEPER_GLOBAL=1: it also runs Telegram linking, the transfer
# watcher, the API check and the gap check, which serve every chain once
CHAIN_ID=143
KEEPER_GLOBAL=1
RPC_URL=https://rpc2.monad.xyz
DEPLOYMENT_FILE=/app/contracts/deployments/monad.json
KYBER_BASE_URL=https://aggregator-api.kyberswap.com/monad/api/v1
KYBER_CLIENT_ID=levra
# On an empty database the recorder reads this many blocks back. About 15,000,000 reaches 29 September 2026 (BE-91)
ORACLE_BACKFILL_BLOCKS=4000000
# The public API address the team monitor checks, the same one Caddy serves
MONITOR_API_URL=https://api.example.sslip.io
TEAM_TELEGRAM_CHAT_ID=
ALERT_EMAIL_FROM=
