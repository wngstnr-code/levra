# Copy to /opt/levra/env/keeper-xlayer.env. Secrets go in /opt/levra/secrets/keeper-xlayer/ (see secrets.md).
LOG_LEVEL=info
# X Layer (BE-95). Without a deployment file and role keys this keeper runs only the Chainlink price recorder (BE-97)
CHAIN_ID=196
KEEPER_GLOBAL=0
# Our X Layer deployment (BE-80): turns on the calendar poster (with CALENDAR_POSTER_KEY), the team monitor and the
# depth table for our markets. Protector and liquidator stay off on X Layer until their task brings them here.
# With TAPEOUT_KEY in the secrets folder it also sends the TapeSend receipts and alerts of every chain (BE-84)
DEPLOYMENT_FILE=/app/contracts/deployments/xlayer.json
# The team group, the same value as in keeper-monad.env; needs TELEGRAM_BOT_TOKEN in the secrets folder
TEAM_TELEGRAM_CHAT_ID=
# The public endpoint answered 403 for about a minute after the first backfill (20 November 2026), then recovered
RPC_URL=https://rpc.xlayer.tech
# Days of feed rounds read back on a feed's first run. The xStocks feeds start on 23 October 2026, so 28 days reach their start
CHAINLINK_BACKFILL_DAYS=28
