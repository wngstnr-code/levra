# Copy to /opt/levra/env/keeper-xlayer.env. Secrets go in /opt/levra/secrets/keeper-xlayer/ (see secrets.md).
LOG_LEVEL=info
# X Layer (BE-95). Without a deployment file and role keys this keeper runs only the Chainlink price recorder (BE-97)
CHAIN_ID=196
KEEPER_GLOBAL=0
# The public endpoint answered 403 for about a minute after the first backfill (20 November 2026), then recovered
RPC_URL=https://rpc.xlayer.tech
# Days of feed rounds read back on a feed's first run. The xStocks feeds start on 23 October 2026, so 28 days reach their start
CHAINLINK_BACKFILL_DAYS=28
