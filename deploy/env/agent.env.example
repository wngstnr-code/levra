# Copy to /opt/levra/env/agent.env. The MCP server for AI agents (BE-77) holds no keys and has no secrets.
PORT=8790
# The API over the internal network. Never the public address: going out and back through Cloudflare would give the
# API the server's own country instead of none, and the region check fails closed only when there is none
LEVRA_API_URL=http://api:8787
# Same value as TRUST_PROXY_HEADER in api.env: x-forwarded-for while DNS only, cf-connecting-ip with ORIGIN=cloudflare
CLIENT_IP_HEADER=x-forwarded-for
