# Copy to /opt/levra/env/api.env. Settings only: secrets go in /opt/levra/secrets/api/ (see secrets.md).
PORT=8787
LOG_LEVEL=info
MONAD_RPC_URL=https://rpc2.monad.xyz
DEPLOYMENT_FILE=/app/contracts/deployments/monad.json
KYBER_BASE_URL=https://aggregator-api.kyberswap.com/monad/api/v1
KYBER_CLIENT_ID=levra
# Hosts of the web app that a sign-in message may name, and the origins that may call the API (same pattern rules)
# Copy the values Railway had (BE-91). Previews: levra-mon-*-<vercel team>.vercel.app, never *.vercel.app
AUTH_DOMAIN=levra-mon.vercel.app
CORS_ORIGINS=https://levra-mon.vercel.app
TELEGRAM_BOT_USERNAME=
TERMS_VERSION=
GEO_COUNTRY_HEADER=
BLOCKED_COUNTRIES=
GEO_REGION_HEADER=
BLOCKED_REGIONS=
# Caddy writes the client address here. Becomes cf-connecting-ip once Cloudflare is in front (BE-52)
TRUST_PROXY_HEADER=x-forwarded-for
