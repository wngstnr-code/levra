# Copy to /opt/levra/env/api.env. Settings only: secrets go in /opt/levra/secrets/api/ (see secrets.md).
PORT=8787
LOG_LEVEL=info
MONAD_RPC_URL=https://rpc2.monad.xyz
DEPLOYMENT_FILE=/app/contracts/deployments/monad.json
# Other chains (BE-95): served under /v1/:chainId when both the RPC endpoint and the deployment file are set. Base quotes
# use KyberSwap, Aero and, with the ONEINCH_API_KEY secret, 1inch (BE-96). X Layer quotes need the OKX_API_KEY,
# OKX_SECRET_KEY and OKX_API_PASSPHRASE secrets (BE-81)
BASE_RPC_URL=
BASE_DEPLOYMENT_FILE=
XLAYER_RPC_URL=
XLAYER_DEPLOYMENT_FILE=
# KyberSwap endpoint for Monad; Base always uses KyberSwap's Base endpoint
KYBER_BASE_URL=https://aggregator-api.kyberswap.com/monad/api/v1
KYBER_CLIENT_ID=levra
# Hosts of the web app that a sign-in message may name, and the origins that may call the API (same pattern rules)
# The web app is on app.levra.finance (05). Only the app signs in. The landing site on levra.finance may read the
# API, so it is a CORS origin; www redirects to it and is not listed. Previews: levra-*-<vercel team>.vercel.app, never *.vercel.app
AUTH_DOMAIN=app.levra.finance
CORS_ORIGINS=https://app.levra.finance,https://levra.finance
TELEGRAM_BOT_USERNAME=
TERMS_VERSION=
# Region checks (BE-52). The GEO headers come from Cloudflare (cf-ipcountry, cf-region-code), so set them only with
# ORIGIN=cloudflare in caddy.env. Country lists: D-42 on every chain, plus D-73 (GB,AU,SG,CH) on Base and X Layer,
# both initial proposals until counsel answers (X-10). A list without GEO_COUNTRY_HEADER stops the API at start
GEO_COUNTRY_HEADER=
BLOCKED_COUNTRIES=
BASE_BLOCKED_COUNTRIES=
XLAYER_BLOCKED_COUNTRIES=
GEO_REGION_HEADER=
BLOCKED_REGIONS=
# Header with the visitor's address: x-forwarded-for (written by Caddy) while DNS only, cf-connecting-ip with
# ORIGIN=cloudflare (BE-52)
TRUST_PROXY_HEADER=x-forwarded-for
