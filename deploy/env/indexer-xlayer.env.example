# Copy to /opt/levra/env/indexer-xlayer.env. Secrets go in /opt/levra/secrets/indexer-xlayer/ (see secrets.md).
LOG_LEVEL=info
# X Layer (BE-80). The deployment file must be for the same chain
CHAIN_ID=196
RPC_URL=https://rpc.xlayer.tech
DEPLOYMENT_FILE=/app/contracts/deployments/xlayer.json
# rpc.xlayer.tech answers 100 blocks per eth_getLogs query and refuses 10,000 (24 November 2026)
LOG_BLOCK_RANGE=100
POLL_MS=2000
# verify:data only: ms between its log queries, 500 when unset on X Layer (initial proposal; the rate limit is not measured)
# VERIFY_PAUSE_MS=500
