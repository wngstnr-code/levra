# Copy to /opt/levra/env/keeper-base.env. Secrets go in /opt/levra/secrets/keeper-base/ (see secrets.md).
LOG_LEVEL=info
# Base (BE-95). Without a deployment file and role keys this keeper runs only the Chainlink price recorder (BE-97)
CHAIN_ID=8453
KEEPER_GLOBAL=0
# The public endpoint serves eth_call, which is all the recorder needs. A paid endpoint comes with our deployment (hosting.md)
RPC_URL=https://mainnet.base.org
# Days of feed rounds read back on a feed's first run. Only the first run uses it; afterwards it goes on from the last round
CHAINLINK_BACKFILL_DAYS=28
