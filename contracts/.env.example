# Copy to contracts/.env and fill in. Never commit the real file and never paste the key anywhere else.
# Use a fresh wallet that holds only what the run needs: about 20 MON and 15 USDC on Monad mainnet.
DEPLOYER_PRIVATE_KEY=

# Optional. Defaults to the deployer.
OWNER=
FEE_RECIPIENT=

# Optional roles. Empty means not set. They can be set later with make set-roles-monad.
# A line here wins over a variable typed in front of make, so pass roles after it: make set-roles-monad KEEPER=0x...
# One key per role: KEEPER runs auto-deleverage, LIQUIDATOR_KEEPER calls the Liquidator (defaults to KEEPER).
KEEPER=
LIQUIDATOR_KEEPER=
CALENDAR_POSTER=
ORACLE_AGE_POSTER=

# Optional. A private RPC is steadier than the public one.
RPC=https://rpc.monad.xyz
